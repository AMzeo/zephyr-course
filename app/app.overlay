/ {
    aliases {
        app-led = &green_led;
        app-led1 = &blue_led;
        app-led2 = &red_led;
    };
};

/ {
    our_driver0: our_driver {
        compatible = "our,driver";
        status = "okay";
    };
};

/ {
    our_custom0: our_custom {
    compatible = "our,custom";
    status = "okay";
    };
};